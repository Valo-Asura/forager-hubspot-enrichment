# =================================================================
# Forager x HubSpot Integration Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# Forager Configuration
# -----------------------------------------------------------------
# Forager API key obtained from app.forager.ai dashboard -> Settings -> API Keys
FORAGER_API_KEY=your_forager_api_key_here

# Forager API base URL (defaults to https://api-v2.forager.ai)
FORAGER_BASE_URL=https://api-v2.forager.ai

# Numeric Forager Account ID from the Forager app's My Account page (required)
FORAGER_ACCOUNT_ID=

# -----------------------------------------------------------------
# HubSpot Configuration
# -----------------------------------------------------------------
# HubSpot Service Key with company/contact read and write scopes
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# HubSpot Client Secret (from App settings; used for SHA-256 HMAC webhook signature verification)
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here

# Required in production for manual enrichment endpoints; send as Authorization: Bearer <key>
MANUAL_API_KEY=your_manual_api_key_here

# HubSpot API base URL (defaults to https://api.hubapi.com)
HUBSPOT_BASE_URL=https://api.hubapi.com

# -----------------------------------------------------------------
# Contact Discovery & Filtering Configuration
# -----------------------------------------------------------------
# Comma-separated normalized job titles/keywords to filter for contact discovery
ALLOWED_JOB_TITLES=Software Engineer,Founding Engineer,Staff Engineer,Principal Engineer,VP of Engineering,CTO,Head of Engineering,Product Manager

# Maximum contacts to discover and enrich per company (PDF target: 5)
MAX_CONTACTS_PER_COMPANY=5

# -----------------------------------------------------------------
# Application Runtime Configuration
# -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
